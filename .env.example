# AGROWTEIN User Dashboard - Environment Configuration Template
# Copy this file to .env.development and fill in your actual values

# ===== BACKEND API =====
# Main API endpoint for connecting to AGROWTEIN backend
# Used for: sensor data, device control, mode switching, user authentication
# Example: https://apiv2.agrowtein.com or http://localhost:3000 (for local development)
VITE_REACT_APP_API_URL=https://apiv2.agrowtein.com
VITE_REACT_APP_API_BASE_URL=https://apiv2.agrowtein.com

# ===== PUSH NOTIFICATIONS =====
# Web Push VAPID Public Key - required for push notifications
# Generate from Firebase Cloud Messaging or similar service
# Used in: PushInit.jsx, Notifications.jsx
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ===== ENQUIRIES/SUPPORT API =====
# API endpoint for storing customer enquiries and support requests
# Used in: Enquiries.jsx
VITE_ENQUIRY_API_URL=https://api.jsonbin.io/v3/b

# ===== EMAIL NOTIFICATIONS =====
# EmailJS configuration for sending contact form and support emails
# Sign up at: https://www.emailjs.com/
VITE_EMAILJS_USER_ID=your_emailjs_user_id_here

# ===== APPLICATION MODE =====
# Set to 'development' for dev, 'production' for builds
VITE_APP_MODE=development

# ===== MQTT BROKER (Optional) =====
# If using MQTT for device communication
# VITE_MQTT_BROKER=mqtt://localhost:1883
# VITE_MQTT_USERNAME=your_mqtt_username
# VITE_MQTT_PASSWORD=your_mqtt_password
