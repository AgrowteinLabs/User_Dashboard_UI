# Development Mode Flag
VITE_APP_MODE=development

# ===== FARM HEALTH SCORE FEATURE FLAG (Phase 2 AI Integration) =====
# Options: 'coming_soon' (default) | 'hidden' | 'active'
# - 'coming_soon': Preserves dashboard slot with "Coming Soon / AI Model in Training" state (no API calls)
# - 'hidden': Completely hides the Farm Health widget (Farm Weather expands to 12 columns, no API calls)
# - 'active': Live farm health score with GET /api/v1/products/:uid/health calls
VITE_FARM_HEALTH_MODE=hidden
